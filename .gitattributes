# ============================================
# 行尾与二进制策略
# 仓库内一律存 LF，避免 Windows/macOS/Linux 检出差异
# ============================================

* text=auto eol=lf

# LaTeX 源码
*.tex      text eol=lf
*.cls      text eol=lf
*.sty      text eol=lf
*.def      text eol=lf
*.bib      text eol=lf
*.bbx      text eol=lf
*.cbx      text eol=lf
*.cfg      text eol=lf
*.ins      text eol=lf
*.dtx      text eol=lf
Makefile   text eol=lf
latexmkrc  text eol=lf
*.md       text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.sh       text eol=lf

# 二进制资源，禁止任何转换
*.pdf      binary
*.jpg      binary
*.jpeg     binary
*.png      binary
*.eps      binary
*.zip      binary
