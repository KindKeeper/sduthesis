\newtoks\fenlei		     % 中图分类号
\newtoks\DWdaihao	     % 单位代号
\newtoks\miji		     % 密级
\newtoks\StuNum		     % 学号
\newtoks\CThesisType     % 论文类型 中
\newtoks\EThesisType     % 论文类型 英
\newtoks\Ctitle		     % 中文标题
\newtoks\Etitle		     % 英文标题
\newtoks\Cauthor	     % 作者中文名
\newtoks\Cmajor		     % 专业
\newtoks\Csuperver	     % 导师
\newtoks\Ccosuperver     % 合作导师
\newtoks\Cdate		     % 中文日期
\newtoks\Dpart		     % 学院
\newtoks\Grade		     % 年级
\newtoks\ThesisHeader	 % 正文页眉
\newtoks\EThesisHeader   % 英文页眉
\newtoks\EducationType   % 培养方式（英文中好像没这个词）
\newtoks\DegreeType      % 学位类型（学术学位、专业学位）

\RequirePackage{makecell}
\RequirePackage{xcolor}
\definecolor{sduColor}{cmyk}{0.26,1,1,0.28}

\newcommand{\LeftLength}{2.8cm}
\newcommand{\RightLength}{6.8cm}
\newcommand{\Mcs}[1]{\makebox[\LeftLength][s]{{\zihao{-3}\songti{}#1}}}
\newcommand{\Mcc}[1]{\makebox[\RightLength][c]{{\zihao{-3}\songti{}#1}}}
\newcommand{\TopTitleLeftOne}[1]{\makebox[2.1cm][s]{{\zihao{-3}\songti{}#1}}}
\newcommand{\TopTitleLeftTwo}[1]{\makebox[2.7cm][s]{{\zihao{-3}\songti{}#1}}}
\newcommand{\TopTitleRight}[1]{\makebox[2.5cm][l]{{\zihao{-3}\songti{}#1}}}

\newcommand{\maketitlepage}{%
	\thispagestyle{empty}

	{
		\ifcolorcover
			\newcommand{\coverlogofile}{figures/SDUWordsColor.pdf}
		\else
			\newcommand{\coverlogofile}{figures/SDUWords.pdf}
		\fi

		\ifcolorcover
			\color{sduColor}
		\fi

		\begin{flushleft}
			\TopTitleLeftOne{分类号：}~~\TopTitleRight{\the\fenlei}\hfill\TopTitleLeftTwo{单位代码：}~~\TopTitleRight{\the\DWdaihao}\\[4mm]
			\TopTitleLeftOne{密级：}~~\TopTitleRight{\the\miji}\hfill\TopTitleLeftTwo{学号：}~~\TopTitleRight{\the\StuNum}
		\end{flushleft}

		\begin{center}
			~
			\vskip 12mm\relax

			{
				{\includegraphics[width = .5\textwidth]{\coverlogofile}}\\[5mm]
				{\fontsize{60pt}{60pt}\bf\heitiFakeBold\the\CThesisType}\\[5mm]
				{\zihao{-2}\the\EThesisType}\\
				{\zihao{1}\bf\heiti （\the\DegreeType）}
			}
			%\par \vskip 15mm \relax
			{
				\begin{flushleft}
					{\zihao{-3}\songti 论文题目：}
					\zihao{-3}\songti \the\Ctitle\\
				\end{flushleft}
			}

			{
			%	\noindent
			%	\zihao{-1}\bf\songti\the\Ctitle\\
				\vskip 2mm
				\zihao{-3}\the\Etitle
			}
			\vfill
			{
				\begin{tabular}{p{\LeftLength}p{\RightLength}}
					\Mcs{作者姓名}& \Mcc{\the\Cauthor}\\[-.8mm]\cline{2-2}\\[-2mm]
					\Mcs{培养单位}& \Mcc{\the\Dpart}\\[-.8mm]\cline{2-2}\\[-2mm]
					\Mcs{培养方式}& \Mcc{\the\EducationType}\\[-.8mm]\cline{2-2}\\[-2mm]
					\Mcs{专业名称}& \Mcc{\the\Cmajor}\\[-.8mm]\cline{2-2}\\[-2mm]
					\Mcs{指导教师}& \Mcc{\the\Csuperver}\\[-.8mm]\cline{2-2}\\[-2mm]
					\Mcs{合作导师}& \Mcc{\the\Ccosuperver}\\[-.8mm]\cline{2-2}
				\end{tabular}
			}
			\par \vskip 20mm \relax
			{
				\ifxetex
					\IfFontExistsTF{SimHei}
					{
						\zihao{3}\heiti\fontspec{SimHei}\the\Cdate
					}
					{
						\zihao{3}\heiti\the\Cdate
					}					
				\else
					\zihao{3}\heiti\the\Cdate
				\fi
			}
		\end{center}

	}
	\clearpage
}